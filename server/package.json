{
  "name": "lifetag-server",
  "version": "1.0.0",
  "description": "LifeTag Node.js Express Backend with PostgreSQL & Prisma ORM",
  "main": "dist/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "lint": "eslint . --ext .ts",
    "test": "vitest run",
    "test:unit": "vitest run --reporter=verbose src/tests/unit",
    "test:integration": "vitest run --reporter=verbose src/tests/integration src/tests/security",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:security": "vitest run src/tests/unit/crypto.utils.spec.ts src/tests/unit/nfc.service.spec.ts",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "db:test:setup": "cross-env DATABASE_URL=\"postgresql://postgres:postgres@localhost:5433/lifetag_test?schema=public\" prisma db push"
  },
  "keywords": [
    "lifetag",
    "nfc",
    "express",
    "postgresql",
    "prisma",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.2.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^7.15.0",
    "@typescript-eslint/parser": "^7.15.0",
    "@vitest/coverage-v8": "^4.1.11",
    "cross-env": "^10.1.0",
    "eslint": "^8.57.0",
    "prisma": "^5.22.0",
    "supertest": "^7.2.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.23.11",
    "typescript": "^5.5.4",
    "vitest": "^4.1.11"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
