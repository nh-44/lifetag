datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  DOCTOR
  FIRST_RESPONDER
}

enum OrgType {
  GOVERNMENT
  PRIVATE
  GOVERNMENT_FUNDED
}

model User {
  id        String   @id @default(uuid())
  userId    String   @unique // e.g., "US12345"
  accountId String   @unique // e.g., "12345"
  name      String
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Patient Profile Relations
  triageProfile  TriageProfile?
  medicalHistory MedicalHistory?

  @@index([accountId])
  @@index([userId])
}

model DoctorProfile {
  id                   String   @id @default(uuid())
  userId               String   @unique // e.g., "DR98765"
  name                 String
  password             String
  contactInfo          String
  medicalLicenseNumber String   @unique
  qualifications       String[]
  hospitalClinic       String
  specialty            String
  // Clinical actions (tag issuance, scans, record access) require verification by the
  // Healthcare Authority operator (scripts/verify-clinician.ts); self-signup alone is not enough.
  verified             Boolean  @default(false)
  verifiedAt           DateTime?
  createdAt            DateTime @default(now())

  @@index([userId])
}

model FirstResponderProfile {
  id               String   @id @default(uuid())
  userId           String   @unique // e.g., "FR54321"
  name             String
  password         String
  occupation       String
  contactInfo      String
  agency           String
  agencyId         String
  organizationType OrgType  @default(GOVERNMENT)
  qualification    String
  verified         Boolean  @default(false)
  verifiedAt       DateTime?
  createdAt        DateTime @default(now())

  @@index([userId])
}

model TriageProfile {
  id                String   @id @default(uuid())
  user              User     @relation(fields: [userId], references: [userId], onDelete: Cascade)
  userId            String   @unique
  age               Int
  bloodGroup        String
  allergies         String[]
  emergencyContacts Json     // Array of { userId, name, phone }
  dnrStatus         Boolean  @default(false)
  organDonor        Boolean  @default(false)
  insuranceId       String?
  primaryPhysician  String?  // Doctor userId reference
  authoritySignature String? // Authority certificate for the currently issued tag
  tagIssuedAt       DateTime? // issuedAt of the only tag that is currently valid; older tags are superseded
  tagIssuedBy       String?   // Doctor userId that certified the current tag
  tagRevokedAt      DateTime? // Set when the patient revokes a lost/stolen tag
  updatedAt         DateTime @updatedAt
}

model MedicalHistory {
  id             String   @id @default(uuid())
  user           User     @relation(fields: [userId], references: [userId], onDelete: Cascade)
  userId         String   @unique
  drinkingHabits String?
  smokingHabits  String?
  medications    String[]
  illnesses      String[]
  surgeries      String[]
  lastCheckup    Json?    // { weight, bmi, sugar, bp }
  updatedAt      DateTime @updatedAt
}

model ScanAuditLog {
  id             String   @id @default(uuid())
  scannedBy      String   // First Responder or Doctor userId
  patientAccount String   // Account ID scanned
  timestamp      DateTime @default(now())
  deviceMeta     String?
  certified      Boolean  @default(false) // Authority-certified AND current tag; the only input the consent gate trusts
  accessType     String   @default("tag-scan") // tag-scan | online-lookup
  tagFreshness   String?  // current | superseded | revoked | unregistered
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique // SHA-256 of the token, never the token itself
  rotatedAt DateTime? // set when exchanged; reuse after a short grace window revokes all sessions
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  
  @@index([userId])
}

model BenchmarkLog {
  id                    String   @id @default(uuid())
  operation             String   // "READ" or "WRITE"
  payloadSizeRaw        Int      // raw JSON size in bytes
  payloadSizeCompressed Int      // compressed Gzip size in bytes
  timeElapsedMs         Float    // time taken in milliseconds
  deviceMeta            String?  // device info/browser user agent
  timestamp             DateTime @default(now())
}
