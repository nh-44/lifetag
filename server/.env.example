# Server Port
PORT=<YOUR_BACKEND_PORT_VALUE>

# Environment Mode (development | staging | production)
NODE_ENV=development

# PostgreSQL Connection String
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE_NAME>?schema=<SCHEMA>
# Examples:
#     Local: postgresql://postgres:postgres@localhost:5432/aegistag_db?schema=public
#     Supabase: postgresql://postgres.xxxx:yourpassword@aws-0-us-east-1.pooler.supabase.com:6543/postgres
#     Neon: postgresql://user:password@ep-cool-name.us-east-2.aws.neon.tech/aegistag?sslmode=require
DATABASE_URL="postgresql://<USERNAME>:<PASSWORD>@localhost:5432/<DATABASE_NAME>?schema=public"

# Authentication Secrets (Generate a secure 256-bit secret key for production)
JWT_SECRET=your_jwt_secret_here_make_it_at_least_32_characters_long

# Frontend URL for CORS
# Examples:
# http://localhost:5173
# https://aegistag.example.com
CORS_ORIGIN=<YOUR_FRONTEND_URL>

# Authority ECDSA P-256 Private Key (JWK format, single line)
# This key signs NFC tag payloads to certify them as authority-approved.
# REQUIRED in all environments — there is no fallback.
#
# To generate a new key pair, run this in Node.js:
#   const { webcrypto } = require('crypto');
#   webcrypto.subtle.generateKey({ name: 'ECDSA', namedCurve: 'P-256' }, true, ['sign', 'verify'])
#     .then(async k => {
#       console.log('PRIVATE:', JSON.stringify(await webcrypto.subtle.exportKey('jwk', k.privateKey)));
#       console.log('PUBLIC:', JSON.stringify(await webcrypto.subtle.exportKey('jwk', k.publicKey)));
#     });
#
# Or use: node -e "require('crypto').generateKeyPair('ec',{namedCurve:'prime256v1',privateKeyEncoding:{type:'pkcs8',format:'jwk'},publicKeyEncoding:{type:'spki',format:'jwk'}},(e,pub,priv)=>console.log(JSON.stringify(priv)))"
#
# Paste the PRIVATE key JSON as a single-line string below (no newlines):
# The PUBLIC key is the client's offline trust anchor: run
#   npx ts-node scripts/print-authority-public-key.ts
# and put the printed VITE_AUTHORITY_PUBLIC_KEYS line in client/.env. The server
# derives its own copy from this private key, so the two can no longer drift.
AUTHORITY_PRIVATE_KEY='{"kty":"EC","crv":"P-256","x":"<YOUR_X>","y":"<YOUR_Y>","d":"<YOUR_D>"}'

# Optional, for key rotation: JSON array of RETIRED authority public JWKs whose
# certificates should still verify until every tag they signed is re-issued.
# Remove a key from this list (and from the client) to revoke it, e.g. after compromise.
# AUTHORITY_TRUSTED_PUBLIC_KEYS=[{"kty":"EC","crv":"P-256","x":"...","y":"..."}]

# Number of reverse proxies in front of the server (Render/Railway/Heroku: 1). Defaults to 1
# in production. Without it all clients share the proxy's IP and one rate-limit bucket.
# TRUST_PROXY=1

# Unauthenticated NFC timing telemetry (POST /api/v1/benchmarks/log). Off in production
# unless set to true; on in development.
# BENCHMARK_LOGGING=false

# Note: in production JWT_SECRET must be at least 32 characters or the server refuses to start.
