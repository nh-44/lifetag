# Server Port
PORT=<YOUR_BACKEND_PORT_VALUE>

# Environment Mode (development | staging | production)
NODE_ENV=development

# PostgreSQL Connection String
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE_NAME>?schema=<SCHEMA>
# Examples:
#     Local: postgresql://postgres:postgres@localhost:5432/lifetag_db?schema=public
#     Supabase: postgresql://postgres.xxxx:yourpassword@aws-0-us-east-1.pooler.supabase.com:6543/postgres
#     Neon: postgresql://user:password@ep-cool-name.us-east-2.aws.neon.tech/lifetag?sslmode=require
DATABASE_URL="postgresql://<USERNAME>:<PASSWORD>@localhost:5432/<DATABASE_NAME>?schema=public"

# Authentication Secrets (Generate a secure 256-bit secret key for production)
JWT_SECRET=your_jwt_secret_here_make_it_at_least_32_characters_long

# Frontend URL for CORS
# Examples:
# http://localhost:5173
# https://lifetag.example.com
CORS_ORIGIN=<YOUR_FRONTEND_URL>

# Authority ECDSA P-256 Private Key (JWK format, single line)
# This key signs NFC tag payloads to certify them as authority-approved.
# REQUIRED in all environments — there is no fallback.
#
# To generate a new key pair, run this in Node.js:
#   const { webcrypto } = require('crypto');
#   webcrypto.subtle.generateKey({ name: 'ECDSA', namedCurve: 'P-256' }, true, ['sign', 'verify'])
#     .then(async k => {
#       console.log('PRIVATE:', JSON.stringify(await webcrypto.subtle.exportKey('jwk', k.privateKey)));
#       console.log('PUBLIC:', JSON.stringify(await webcrypto.subtle.exportKey('jwk', k.publicKey)));
#     });
#
# Or use: node -e "require('crypto').generateKeyPair('ec',{namedCurve:'prime256v1',privateKeyEncoding:{type:'pkcs8',format:'jwk'},publicKeyEncoding:{type:'spki',format:'jwk'}},(e,pub,priv)=>console.log(JSON.stringify(priv)))"
#
# Paste the PRIVATE key JSON as a single-line string below (no newlines):
# The PUBLIC key goes into client/src/services/nfcCryptoService.ts → AUTHORITY_PUBLIC_KEY_JWK
AUTHORITY_PRIVATE_KEY='{"kty":"EC","crv":"P-256","x":"<YOUR_X>","y":"<YOUR_Y>","d":"<YOUR_D>"}'
